//============================================================================
//  Tang Mega 138K Pro Dock pin constraints — T2 video bring-up.
//
//  Pin assignments follow Sipeed's dock reference constraint file
//  (TangMega-138KPro-example, cam2hdmi_alt/cam2dvi/src/138K_PRO_DOCK.cst);
//  we use DVI TX port 0. Differential pairs are constrained on the positive
//  port only, with both pads listed — the negative port must not appear.
//============================================================================

// 50 MHz board clock
IO_LOC "clk" P16;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// reset button (active low)
IO_LOC "rst_n" K16;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// status LEDs (active low)
IO_LOC "led[0]" J14;
IO_LOC "led[1]" R26;
IO_LOC "led[2]" L20;
IO_LOC "led[3]" M25;
IO_LOC "led[4]" N21;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// DVI TX port 0.
//
// IO_TYPE is stated explicitly and each half of every pair gets its own
// IO_LOC, matching the arrangement proven on this board by
// Pedrocasf/486tang (src/boards/mega_pro.cst). Left to choose, the fitter
// picks a 2.5 V standard - LVDS25 for TLVDS_OBUF, LVDS25E for ELVDS_OBUF -
// and this bank runs at 3.3 V, which is a dead link with no error anywhere
// in the build.
IO_LOC "tmds_clk_p" Y22;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_clk_n" Y23;
IO_PORT "tmds_clk_n" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[0]" AB24;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_n[0]" AC24;
IO_PORT "tmds_d_n[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[1]" V24;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_n[1]" W24;
IO_PORT "tmds_d_n[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[2]" AA22;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_n[2]" AA23;
IO_PORT "tmds_d_n[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
